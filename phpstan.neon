includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Shared upload rules; their first user is the member NID upload (Phase 4).
        -
            identifier: trait.unused
            path: app/Concerns/UploadValidationRules.php

# The cPanel document root for this domain is the project root, not public/.
# Send every request into public/ so the app is served and nothing outside it
# (.env, vendor/, storage/, source files) can be reached from the web.
# The better long-term setup is pointing the domain's document root at public/.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve a directory listing.
    Options -Indexes

    # Already inside public/: leave it alone.
    RewriteRule ^public/ - [L]

    # Everything else is handled by public/ (static files, then index.php).
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
